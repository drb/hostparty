# Test hosts file for hostparty
# This file contains various edge cases

# Loopback addresses
127.0.0.1	localhost
::1	localhost localhost.ipv6

# Basic entries with tabs
1.2.3.4	caps.lol	one-two-three-four.count
1.2.3.5	2nd-one-two-three.count	repeated-host.net

# Entry with multiple spaces
5.5.5.5    five.five

# Google DNS servers
8.8.4.4 dns-4-4.google.com x.dns.google.de xx.google.x
8.8.8.8 dns.google.com dns.google.de

# Mixed case hostnames
9.8.7.6 capital.xo lower-case.net xo.capital

# Entries to test removal
10.5.6.7 blah.com foo.net
45.6.7.8 123.org abcdefg.io boo-goose.co.uk dave.net xyz.com

# Long hostname entry
10.20.30.40 ten-twenty-thirty.forty.com

# IP with no hostname (edge case)
192.168.1.1

# Duplicate IP on separate lines (should merge)
67.89.67.89 dogs.com
67.89.67.89 cats.com

# Entry with inline comment style (common in real hosts files)
172.16.0.1 internal.local
